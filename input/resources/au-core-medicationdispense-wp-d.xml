<?xml version="1.0" encoding="UTF-8"?>
<StructureDefinition xmlns="http://hl7.org/fhir">
  <id value="au-core-medicationdispense-wp-d"/>
  <url value="https://dbojicic.github.io/fhir-ig-testing/StructureDefinition/au-core-medicationdispense-wp-d"/>
  <name value="AUCoreMedicationDispenseWPD"/>
  <title value="AU Core MedicationDispense whenPrepared Test D - Date or DAR Required"/>
  <status value="draft"/>
  <experimental value="true"/>
  <description value="Test profile requiring whenPrepared and requiring either a value or a Data Absent Reason extension."/>
  <kind value="resource"/>
  <abstract value="false"/>
  <type value="MedicationDispense"/>
  <baseDefinition value="http://hl7.org.au/fhir/core/StructureDefinition/au-core-medicationdispense"/>
  <derivation value="constraint"/>
  <differential>
    <element id="MedicationDispense">
      <path value="MedicationDispense"/>
     </element>
    <element id="MedicationDispense.whenPrepared">
      <path value="MedicationDispense.whenPrepared"/>
      <min value="1"/>
      <constraint>
        <key value="wp-d-01"/>
        <severity value="error"/>
        <human value="whenPrepared shall have either a value or a Data Absent Reason"/>
        <expression value="$this.hasValue() or extension('http://hl7.org/fhir/StructureDefinition/data-absent-reason').exists()"/>
      </constraint>
    </element>
  </differential>
</StructureDefinition>